# Template for functions/.env.<projectId> or functions/.env.<alias>.
# Copy, fill in and never commit a file containing real secrets.
#
# Only NON-SECRET values belong here. Secrets go to Secret Manager:
#   firebase functions:secrets:set META_APP_SECRET

APP_ENV=development

APP_BASE_URL=http://localhost:5173
API_BASE_URL=
OAUTH_REDIRECT_URI=
MEDIA_PULL_BASE_URL=

TASKS_LOCATION=europe-west1
MEDIA_BUCKET=
WORKER_URL=
WORKER_QUEUE=publisher-worker
WORKER_INVOKER_SERVICE_ACCOUNT=
KMS_KEY_NAME=

# Development only. Must be false in production.
ENABLE_MOCK_PROVIDER=true

META_APP_ID=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
TIKTOK_CLIENT_KEY=
PINTEREST_APP_ID=
GOOGLE_OAUTH_CLIENT_ID=

# ── AI caption generation ────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=45000
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=
AI_QUOTA_PER_DAY=100
AI_QUOTA_PER_HOUR=30
ENABLE_MOCK_AI=true
