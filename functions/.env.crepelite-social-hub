# Non-secret configuration for the `crepelite-social-hub` project.
# Secrets live in Secret Manager — never here. See docs/deployment.md.

APP_ENV=production

# Public URLs. Update if a custom domain replaces the default Hosting site.
APP_BASE_URL=https://crepelite-social-hub.web.app
API_BASE_URL=https://crepelite-social-hub.web.app/api
OAUTH_REDIRECT_URI=https://crepelite-social-hub.web.app/api/oauth/callback
MEDIA_PULL_BASE_URL=https://crepelite-social-hub.web.app/media-pull

# Infrastructure. Firestore, the functions and the task queue are all in
# europe-west1 so a publish never crosses a continent.
FUNCTIONS_REGION=europe-west1
TASKS_LOCATION=europe-west1
MEDIA_BUCKET=crepelite-social-hub.firebasestorage.app

# The mock provider must never be reachable in production.
ENABLE_MOCK_PROVIDER=false

# Provider app ids (public halves; the secrets are in Secret Manager).
# Fill these in as each provider is approved — see
# docs/provider-approval-checklist.md.
META_APP_ID=
META_GRAPH_VERSION=v26.0
TIKTOK_CLIENT_KEY=
PINTEREST_APP_ID=
GOOGLE_OAUTH_CLIENT_ID=
