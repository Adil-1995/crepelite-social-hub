{
  "name": "@crepelite/publisher-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "description": "Cloud Run worker for heavy media transfers (TikTok FILE_UPLOAD, YouTube resumable uploads, Pinterest video). Runs the same publishing engine as Cloud Functions.",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "deploy": "gcloud run deploy publisher-worker --source . --region europe-west1 --no-allow-unauthenticated"
  },
  "dependencies": {
    "@google-cloud/kms": "^6.2.0",
    "@google-cloud/tasks": "^7.1.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "esbuild": "^0.28.2"
  }
}
