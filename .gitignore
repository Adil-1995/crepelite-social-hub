# Dependencies
node_modules/

# Build output
dist/
functions/lib/
worker/dist/
*.tsbuildinfo

# Generated
src/components.d.ts
dev-dist/

# Environment & secrets — never commit these
.env
.env.*
*.pem
*serviceAccount*.json
*credentials*.json

# Exceptions: templates and non-secret Firebase Functions config.
# Firebase requires the .env.<alias> filename, and these files hold only public
# ids and URLs — every actual secret lives in Secret Manager.
!.env.example
!**/.env.example
!functions/.env.crepelite-social-hub
!.env.production
!functions/.secret.local.example

# Firebase
.firebase/
.emulator-data/
firebase-debug.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Test output
coverage/
.vitest/
