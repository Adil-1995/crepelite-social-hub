{
  "name": "crepelite-social-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CrepeLite Social Hub — multi-network social publishing PWA",
  "workspaces": [
    "shared",
    "functions",
    "worker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --project demo-crepelite --import ./.emulator-data --export-on-exit",
    "build": "npm run build:web && npm run build:functions && npm run build:worker",
    "build:web": "vite build",
    "build:functions": "npm --workspace functions run build",
    "build:worker": "npm --workspace worker run build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p shared && tsc --noEmit -p functions && tsc --noEmit -p worker && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project shared --project functions --project web",
    "test:watch": "vitest --project shared --project functions --project web",
    "test:emulator": "firebase emulators:exec --project demo-crepelite --only firestore,storage,auth \"vitest run --project rules --project integration\"",
    "test:all": "npm run test && npm run test:emulator",
    "deploy:staging": "firebase deploy --project staging",
    "deploy:production": "node scripts/confirm-production.mjs && firebase deploy --project production",
    "deploy:worker": "npm --workspace worker run deploy",
    "seed": "node scripts/seed.mjs",
    "dev:full": "concurrently -n emulators,vite -c blue,green \"npm run emulators\" \"npm run dev\""
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "luxon": "^3.7.2",
    "pinia": "^4.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true
  }
}
