# ─────────────────────────────────────────────────────────────────────────────
# CrepeLite Social Hub — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Everything with a VITE_ prefix is INLINED INTO THE CLIENT BUNDLE and is
# therefore public. Firebase web config values are public by design (access is
# controlled by Firestore/Storage rules, not by the API key).
#
# Server-only secrets (social provider credentials) never live here — they go
# into Google Secret Manager. See docs/deployment.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Client (public) ──────────────────────────────────────────────────────────

# `true` routes the app at the Firebase Emulator Suite instead of the cloud.
VITE_USE_EMULATORS=true

# development | staging | production. Gates dev-only affordances such as the
# MockProvider. Never set to `development` on a real deployment.
VITE_APP_ENV=development

# Region the callable functions are deployed to.
VITE_FUNCTIONS_REGION=europe-west1

# Firebase web app config — from:
#   firebase apps:sdkconfig WEB <appId> --project <projectId>
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (FCM) VAPID public key. Firebase console →
# Project settings → Cloud Messaging → Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# ── Server-only (NEVER prefixed with VITE_, NEVER committed) ─────────────────
#
# In production these are stored in Secret Manager and bound to the functions,
# not read from a file. Listed here so local emulator runs can set them.
#
# Meta (Facebook + Instagram) — developers.facebook.com
# META_APP_ID=
# META_APP_SECRET=
#
# TikTok — developers.tiktok.com
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
#
# Pinterest — developers.pinterest.com
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
#
# Google / YouTube — console.cloud.google.com
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# AI caption generation. Server-side only — the key never reaches the client.
# OPENAI_API_KEY=
#
# Key used to encrypt provider tokens at rest in the token vault.
# Prefer a Cloud KMS key reference; the raw key is a local-dev fallback.
# TOKEN_VAULT_KMS_KEY=
# TOKEN_VAULT_LOCAL_KEY=
#
# Public base URL used to build OAuth redirect URIs.
# PUBLIC_APP_URL=https://creplite.web.app
